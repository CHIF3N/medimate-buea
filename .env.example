# Mobile Money through Fapshi (https://docs.fapshi.com). Set these in Vercel, never in the browser.
# Without them, payments run in a clearly labelled demo mode.
FAPSHI_API_USER=
FAPSHI_API_KEY=
# https://sandbox.fapshi.com (default) or https://live.fapshi.com
FAPSHI_BASE_URL=https://sandbox.fapshi.com
# 1 = push the payment prompt to the phone (direct pay must be activated on live); otherwise a hosted checkout link
FAPSHI_DIRECT_PAY=
# Secret set on the Fapshi dashboard for the webhook https://<domain>/api/fapshi-webhook
FAPSHI_WEBHOOK_SECRET=
